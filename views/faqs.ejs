<%- layout("/layouts/boilerplate") %>

<section class="form-page container" style="padding: 4rem 2rem 5rem 2rem;">
    <div class="form-page__intro">
        <div>
            <span class="eyebrow"><i class="bi bi-question-circle"></i> FAQs</span>
            <h1>Frequently Asked Questions</h1>
            <p>Find answers to common questions about StayVista bookings and account management.</p>
        </div>
    </div>

    <div class="form-shell" style="padding: 2.5rem;">
        <div class="faq-container">
            <div class="faq-category">
                <h2>Booking & Reservations</h2>
                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>How do I make a booking?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Browse our listings, select your desired dates, review the property details and pricing, and proceed to checkout. Complete the payment to confirm your reservation.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>Can I modify my booking dates?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes, you can modify your booking dates up to 7 days before check-in, subject to availability and any applicable fees. Contact support for assistance.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>What payment methods do you accept?</span>
                    </div>
                    <div class="faq-answer">
                        <p>We accept major credit cards (Visa, Mastercard, American Express), PayPal, Apple Pay, and Google Pay for secure transactions.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>What is your cancellation policy?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Cancellation policies vary by property. Most offer free cancellation up to 7 days before check-in. Review the specific policy before booking.</p>
                    </div>
                </div>
            </div>

            <div class="faq-category">
                <h2>Account & Login</h2>
                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>How do I create an account?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Click "Sign Up" on the home page, enter your email and password, and verify your email address. Your account will be ready to use immediately.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>I forgot my password. What should I do?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Click "Forgot Password" on the login page, enter your email, and follow the password reset instructions sent to your inbox.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>Can I delete my account?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes, you can request account deletion from your account settings. Your data will be permanently removed after a 30-day grace period.</p>
                    </div>
                </div>
            </div>

            <div class="faq-category">
                <h2>Properties & Listings</h2>
                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>How do I list my property?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Click "Add Stay" in the header, fill in your property details, upload high-quality photos, set your prices, and submit for review. Approval takes 3-5 business days.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>What makes a quality listing?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Clear descriptions, high-quality photos, accurate pricing, competitive amenities, and positive reviews all contribute to a successful listing.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>Can I set my own pricing?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes, you set your nightly rate. We recommend researching similar properties in your area for competitive pricing strategies.</p>
                    </div>
                </div>
            </div>

            <div class="faq-category">
                <h2>Support & Policies</h2>
                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>What if I have an issue with my booking?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Contact our support team immediately. We work to resolve issues quickly and fairly for both guests and hosts.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>How do I report a problem with a property?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Use the "Report Issue" feature in your booking details or contact our support team with photos and documentation of the issue.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>Is StayVista secure?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes, we use industry-standard SSL encryption and secure payment gateways to protect your personal and financial information.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <i class="bi bi-chevron-right"></i>
                        <span>How do reviews work?</span>
                    </div>
                    <div class="faq-answer">
                        <p>Both guests and hosts can leave reviews after a stay. Reviews are verified and help build trust in our community.</p>
                    </div>
                </div>
            </div>

            <div class="faq-cta">
                <p>Didn't find your answer? <a href="/contact" class="cta-link">Contact our support team</a></p>
            </div>
        </div>
    </div>
</section>

<style>
    .faq-container {
        max-width: 900px;
    }

    .faq-category {
        margin-bottom: 3rem;
    }

    .faq-category h2 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 1.5rem 0;
        color: var(--text);
        padding-bottom: 0.75rem;
        border-bottom: 2px solid rgba(196, 149, 106, 0.2);
    }

    .faq-item {
        margin-bottom: 1rem;
        border: 1px solid rgba(196, 149, 106, 0.12);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .faq-item:hover {
        border-color: rgba(196, 149, 106, 0.25);
        box-shadow: 0 4px 12px rgba(196, 149, 106, 0.08);
    }

    .faq-question {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        background: rgba(196, 149, 106, 0.04);
        cursor: pointer;
        user-select: none;
        transition: background 0.3s ease;
    }

    .faq-item:hover .faq-question {
        background: rgba(196, 149, 106, 0.08);
    }

    .faq-question i {
        color: var(--accent);
        font-size: 1.1rem;
        transition: transform 0.3s ease;
    }

    .faq-item.active .faq-question i {
        transform: rotate(90deg);
    }

    .faq-question span {
        font-weight: 600;
        color: var(--text);
        font-size: 1rem;
    }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        padding: 0 1.25rem;
    }

    .faq-item.active .faq-answer {
        max-height: 300px;
        padding: 0 1.25rem 1.25rem 1.25rem;
    }

    .faq-answer p {
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.7;
        margin: 0;
    }

    .faq-cta {
        text-align: center;
        padding: 2rem;
        background: rgba(110, 200, 158, 0.05);
        border: 1px solid rgba(110, 200, 158, 0.12);
        border-radius: 12px;
        margin-top: 2.5rem;
    }

    .faq-cta p {
        color: var(--muted);
        margin: 0;
    }

    .cta-link {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .cta-link:hover {
        color: var(--accent-strong);
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .faq-category h2 {
            font-size: 1.2rem;
        }

        .faq-question {
            padding: 1rem;
        }

        .faq-answer {
            padding: 0 1rem !important;
        }

        .faq-item.active .faq-answer {
            padding: 0 1rem 1rem 1rem !important;
        }
    }
</style>

<script>
    document.querySelectorAll('.faq-question').forEach(question => {
        question.addEventListener('click', function() {
            const faqItem = this.closest('.faq-item');
            faqItem.classList.toggle('active');
        });
    });
</script>
