<%- layout("/layouts/boilerplate") %>

<section class="listing-page container-fluid px-4 px-lg-5 py-5">
    <div class="listing-page__header">
        <div>
            <span class="eyebrow"><i class="bi bi-stars"></i> Curated collection</span>
            <h1>Explore Stays</h1>
            <p>Browse stylish stays, premium hotels, and homestays built for comfort and clean design.</p>
        </div>
        <a class="btn btn-accent" href="/listings/new">
            <i class="bi bi-plus-lg"></i>
            Add a Stay
        </a>
    </div>

    <!-- Filter Bar -->
    <div class="filters-bar">
        <% 
        const categories = [
            { name: 'Trending', icon: 'bi-fire' },
            { name: 'Rooms', icon: 'bi-house-fill' },
            { name: 'Iconic Cities', icon: 'bi-buildings' },
            { name: 'Mountains', icon: 'bi-triangle-fill' },
            { name: 'Castles', icon: 'bi-bank' },
            { name: 'Amazing Pools', icon: 'bi-water' },
            { name: 'Camping', icon: 'bi-tree-fill' },
            { name: 'Farms', icon: 'bi-flower1' },
            { name: 'Arctic', icon: 'bi-snow' }
        ];
        %>
        
        <a href="/listings" class="filter-item <%= typeof selectedCategory === 'undefined' || !selectedCategory ? 'active' : '' %>">
            <i class="bi bi-globe"></i>
            <span>All Stays</span>
        </a>
        
        <% categories.forEach(cat => { %>
            <a href="/listings?category=<%= encodeURIComponent(cat.name) %>" class="filter-item <%= typeof selectedCategory !== 'undefined' && selectedCategory === cat.name ? 'active' : '' %>">
                <i class="bi <%= cat.icon %>"></i>
                <span><%= cat.name %></span>
            </a>
        <% }) %>
        <!-- TAX TOGGLE -->
        <div class="tax-toggle-wrapper">
    
        <span class="tax-text">Display total before taxes</span>

        <label class="switch">
        <input type="checkbox" id="taxToggle">
        <span class="slider"></span>
        </label>
        </div>
    </div>

   

    <% if (allListings.length) { %>
        <div class="listing-grid">
            <% allListings.forEach((listing, index) => { %>
                <a class="listing-card" href="/listings/<%= listing._id %>" style="--card-index:<%= index %>">
                    <div class="listing-card__image-wrap">
                        <img src="<%= listing.image && listing.image.url ? listing.image.url : '' %>" class="listing-card__image" alt="<%= listing.title %>">
                        <span class="listing-card__tag"><i class="bi bi-geo-alt-fill"></i> <%= listing.location %></span>
                    </div>
                    <div class="listing-card__body">
                        <div>
                            <h2><%= listing.title %></h2>
                            <p><%= listing.country %></p>
                        </div>
                        <div class="listing-card__footer">
                            <span class="listing-card__price">&#8377; <%= Number(listing.price || 0).toLocaleString("en-IN") %> <small>/ night</small></span>
                            <span class="listing-card__action">View stay <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="bi bi-building-exclamation"></i>
            <h2>No listings yet</h2>
            <p>Add the first StayVista listing to start building your collection.</p>
        </div>
    <% } %>
</section>
