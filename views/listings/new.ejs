<%- layout("/layouts/boilerplate") %>

<section class="form-page container py-5">
    <div class="form-page__intro">
        <div>
            <span class="eyebrow"><i class="bi bi-pencil-square"></i> New listing</span>
            <h1>Create a new stay</h1>
            <p>Add the property details below to publish a polished StayVista listing.</p>
        </div>
    </div>

    <div class="form-shell">
        <form method="post" action="/listings" class="listing-form needs-validation" novalidate enctype="multipart/form-data">
            <div class="form-grid">
                <label class="field">
                    <span>Title</span>
                    <input name="listing[title]" class="form-control" placeholder="Enter the title" type="text" required>
                    <div class="invalid-feedback">Title is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field field--wide">
                    <span>Description</span>
                    <textarea name="listing[description]" class="form-control" placeholder="Write a short description" rows="5"></textarea>
                </label>

                <label class="field field--wide">
                    <span>Photo</span>
                    <input name="image" class="form-control" type="file" accept="image/*" required>
                    <small class="form-text text-muted">Upload a high-quality image (JPEG, PNG, WebP, etc.)</small>
                    <div class="invalid-feedback">Please upload an image</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field field--wide">
                    <span>Gallery Images</span>
                    <input name="gallery" class="form-control" type="file" accept="image/*" multiple>
                    <small class="form-text text-muted">Upload up to 10 images for the gallery (optional)</small>
                </label>

                <label class="field">
                    <span>Price</span>
                    <input name="listing[price]" class="form-control" placeholder="Enter the price" type="number" min="0" required>
                    <div class="invalid-feedback">Please provide a valid price</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field">
                    <span>Country</span>
                    <input name="listing[country]" class="form-control" placeholder="Enter the country" type="text" required>
                    <div class="invalid-feedback">Country is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field field--wide">
                    <span>Location</span>
                    <input name="listing[location]" class="form-control" placeholder="Enter the location" type="text" required>
                    <div class="invalid-feedback">Location is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <div class="field field--wide mt-3 mb-2">
                    <span class="mb-3 d-block fw-semibold">Property Categories</span>
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                        <% 
                        categories.forEach((cat, index) => { 
                        %>
                        <div class="col">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="<%= cat %>" id="cat-<%= index %>">
                                <label class="form-check-label" for="cat-<%= index %>">
                                    <%= cat %>
                                </label>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="/listings" class="btn btn-ghost">Cancel</a>
                <button class="btn btn-accent" type="submit">Add Listing</button>
            </div>
        </form>
    </div>
</section>