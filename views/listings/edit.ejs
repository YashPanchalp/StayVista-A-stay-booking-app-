<%- layout("/layouts/boilerplate") %>

<section class="form-page container py-5">
    <div class="form-page__intro">
        <div>
            <span class="eyebrow"><i class="bi bi-sliders"></i> Edit listing</span>
            <h1>Refine the listing</h1>
            <p>Update the stay details while keeping the same polished StayVista presentation.</p>
        </div>
    </div>

    <div class="form-shell">
        <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="listing-form needs-validation" novalidate enctype="multipart/form-data">
            <div class="form-grid">
                <label class="field">
                    <span>Title</span>
                    <input name="listing[title]" class="form-control" value="<%= listing.title %>" type="text" required>
                    <div class="invalid-feedback">Title is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field field--wide">
                    <span>Description</span>
                    <textarea name="listing[description]" class="form-control" rows="5"><%= listing.description %></textarea>
                </label>

                <label class="field field--wide">
                    <span>Photo</span>
                    <% if(listing.image && listing.image.url) { %>
                    <div class="mb-3">
                        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" style="max-width: 200px; max-height: 150px; border-radius: 4px;">
                        <p class="small mt-2">Current photo</p>
                    </div>
                    <% } %>
                    <input name="image" class="form-control" type="file" accept="image/*">
                    <small class="form-text text-muted">Upload a new image to replace the current one (optional)</small>
                </label>

                <label class="field field--wide">
                    <span>Gallery Images</span>
                    <% if(listing.gallery && listing.gallery.length > 0) { %>
                    <div class="mb-3">
                        <p class="small mb-2"><strong>Current Gallery:</strong></p>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px;">
                            <% listing.gallery.forEach((img, idx) => { %>
                            <div style="position: relative; border-radius: 4px; overflow: hidden;">
                                <img src="<%= img.url %>" alt="Gallery image <%= idx + 1 %>" style="width: 100%; height: 100px; object-fit: cover; display: block;">
                                <span style="font-size: 0.75rem; color: #666; display: block; text-align: center; padding: 4px 0;">Image <%= idx + 1 %></span>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <% } %>
                    <input name="gallery" class="form-control" type="file" accept="image/*" multiple>
                    <small class="form-text text-muted">Upload new gallery images (up to 10). Uploading new images will replace existing gallery (optional)</small>
                </label>

                <label class="field">
                    <span>Price</span>
                    <input name="listing[price]" class="form-control" value="<%= listing.price %>" type="number" min="0" required>
                    <div class="invalid-feedback">Please provide a valid price</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field">
                    <span>Country</span>
                    <input name="listing[country]" class="form-control" value="<%= listing.country %>" type="text" required>
                    <div class="invalid-feedback">Country is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <label class="field field--wide">
                    <span>Location</span>
                    <input name="listing[location]" class="form-control" value="<%= listing.location %>" type="text" required>
                    <div class="invalid-feedback">Location is required</div>
                    <div class="valid-feedback">Looks good!</div>
                </label>

                <div class="field field--wide mt-3 mb-2">
                    <span class="mb-3 d-block fw-semibold">Property Categories</span>
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                        <% 
                        const categories = ['Trending', 'Rooms', 'Iconic Cities', 'Mountains', 'Castles', 'Amazing Pools', 'Camping', 'Farms', 'Arctic'];
                        const selectedCats = listing.category || [];
                        categories.forEach((cat, index) => { 
                            const isChecked = selectedCats.includes(cat) ? 'checked' : '';
                        %>
                        <div class="col">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[category][]" value="<%= cat %>" id="cat-<%= index %>" <%= isChecked %>>
                                <label class="form-check-label" for="cat-<%= index %>">
                                    <%= cat %>
                                </label>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a href="/listings/<%= listing._id %>" class="btn btn-ghost">Back</a>
                <button class="btn btn-accent" type="submit">Save Changes</button>
            </div>
        </form>
    </div>
</section>