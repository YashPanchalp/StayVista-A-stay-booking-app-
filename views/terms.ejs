<style>
    .legal-content {
        max-width: 900px;
        font-size: 0.95rem;
        line-height: 1.8;
    }

    .toc-section {
        background: rgba(196, 149, 106, 0.05);
        border: 1px solid rgba(196, 149, 106, 0.12);
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2.5rem;
    }

    .toc-section h3 {
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--text);
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .toc-list li {
        padding: 0.5rem 0;
    }

    .toc-list a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .toc-list a:hover {
        color: var(--accent-strong);
        text-decoration: underline;
    }

    .legal-section {
        margin-bottom: 2.5rem;
    }

    .legal-section h2 {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0 0 1rem 0;
        color: var(--text);
        padding-bottom: 0.75rem;
        border-bottom: 2px solid rgba(196, 149, 106, 0.2);
    }

    .legal-section p {
        margin: 0 0 1rem 0;
        color: var(--muted);
    }

    .conduct-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
    }

    .conduct-list li {
        padding: 0.6rem 0 0.6rem 2rem;
        position: relative;
        color: var(--muted);
    }

    .conduct-list li:before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: bold;
    }

    .contact-info {
        background: rgba(196, 149, 106, 0.04);
        border-left: 3px solid var(--accent);
        padding: 1.5rem;
        margin: 1.5rem 0;
        border-radius: 4px;
    }

    .contact-info p {
        margin: 0.5rem 0;
        color: var(--text);
    }

    .legal-footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
    }

    @media (max-width: 768px) {
        .legal-content {
            font-size: 0.9rem;
        }

        .toc-section {
            padding: 1.5rem;
        }

        .legal-section h2 {
            font-size: 1.2rem;
        }

        .contact-info {
            padding: 1rem;
        }
    }
</style>
