    </div>

    <div class="form-shell" style="padding: 2.5rem;">
        <div class="legal-content">
            <div class="toc-section">
                <h3>Table of Contents</h3>
                <ul class="toc-list">
                    <li><a href="#section1">1. Acceptance of Terms</a></li>
                    <li><a href="#section2">2. User Accounts</a></li>
