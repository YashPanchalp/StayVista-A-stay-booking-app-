          </a>
        <% } else { %>
          <a class="nav-link site-nav-link <%= currentPath === '/login' ? 'active' : '' %>" href="/login">
            <i class="bi bi-box-arrow-in-right"></i>
            Login
          </a>
          <a class="nav-link site-nav-link <%= currentPath === '/signup' ? 'active' : '' %>" href="/signup">
            <i class="bi bi-person-plus"></i>
            Sign up
          </a>
        <% } %>
      </div>
    </div>
